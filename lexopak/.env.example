# Copy to .env and fill in.

# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Password for the newsroom at /admin
ADMIN_PASSWORD=
# Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

SITE_URL=https://lexopak.com
SITE_NAME=Lexopak
# sq = Albanian, en = English (site language and language of AI drafts)
SITE_LANG=sq

# How often to check the sources, in minutes
POLL_MINUTES=5
# true = draft every new story automatically (each draft costs API credits; nothing is published without you)
AUTO_DRAFT=false
# Max web searches the AI may run per article
MAX_WEB_SEARCHES=5
# CLAUDE_MODEL=claude-opus-5-5

PORT=3000
DB_PATH=./data/lexopak.db
