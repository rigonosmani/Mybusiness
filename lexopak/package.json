{
  "name": "lexopak",
  "version": "0.1.0",
  "private": true,
  "description": "Lexopak news site: source listener + AI-assisted original reporting with editor review",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "echo \"No build step needed\"",
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.js",
    "poll": "node --disable-warning=ExperimentalWarning src/poll-once.mjs",
    "cron": "node --disable-warning=ExperimentalWarning src/cron.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "marked": "^18.1.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.18.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.4.1"
  },
  "main": "src/index.js"
}
