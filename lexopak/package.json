{
  "name": "lexopak",
  "version": "0.1.0",
  "private": true,
  "description": "Lexopak news site: source listener + AI-assisted original reporting with editor review",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/server.js",
    "poll": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/poll-once.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "marked": "^18.1.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.18.1"
  }
}
