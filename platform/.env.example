# ---- Browser-safe (public) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Must match AUTH_EMAIL_DOMAIN of the admin-users Edge Function. Usernames are
# mapped to <username>@<domain> internally; nobody needs a real mailbox.
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=accounts.kometa.local

# ---- Server-only (scripts / never shipped to the browser) ------------------
# Used ONLY by `npm run bootstrap` on your machine. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_PASSWORD=change-me-Str0ng
BOOTSTRAP_INITIAL_CREDITS=1000
# Optional demo hierarchy (Test A/B accounts): set to "true" to create them.
BOOTSTRAP_DEMO_ACCOUNTS=false
BOOTSTRAP_DEMO_PASSWORD=Demo-Passw0rd

# ---- Edge Function secrets (set with `supabase secrets set ...`) -----------
# ODDS_API_KEY=...                  The Odds API key (https://the-odds-api.com)
# API_SPORTS_KEY=...                API-Sports key (optional, adapter scaffolded)
# CRON_SECRET=...                   shared secret for odds-sync / maintenance
# AUTH_EMAIL_DOMAIN=accounts.kometa.local
# ALLOWED_ORIGINS=https://your-domain.example
# PROVIDER_SECRET_LICENSED_AGGREGATOR=...  only once a licensed provider is contracted
